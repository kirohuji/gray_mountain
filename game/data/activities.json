        "examine_bag": {
            "id": "examine_bag",
            "name": "查看行李袋",
            "room": "foyer",
            "type": "examine",
            "once": true,
            "flag": "examined_bag",
            "description": "深灰色的帆布袋靠在鞋柜侧面。不是平时出门用的那一只——这是疗养院的物品，侧面贴着一张白色标签，上面用墨水写着你的名字：卡特，汤姆。\n\n袋子的侧面有一层灰白色的粉末。你用拇指抹了一下——很细，滑腻。不像普通的灰尘，倒更像是……石粉。\n\n你打开袋口。里面是你的几件换洗衣物，叠得不整齐——不是你的叠法。是别人帮你收拾的。你不想去回忆是谁。",
            "narrative": {
                "jump": "act_examine_bag"
            }
        },
